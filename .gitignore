# Secrets. Every deployed tier reads its credentials from a host-side file that
# is created by hand, chmod 600, and never committed. The *.example files next
# to them document the names.
deploy/stacks/*.env
deploy/stacks/*.aim-*
# The machine API's bearer tokens (D-072): prod.api-admin, prod.api-qa and
# prod.api-qa-out, gaos_<hex>, mode 600. The outbound one stays empty until the
# QA tools implement their side.
deploy/stacks/*.api-*
# The back office's accounts file and session key (D-079): prod.bo-users and
# prod.bo-session-key, mode 600. A hash file plus the key forges any session.
deploy/stacks/*.bo-*
# The Brain Town receiver's bearer token (D-086): prod.bt-token, mode 600, may be empty.
deploy/stacks/*.bt-*
# The pull-request flow's credentials (D-088): the GitHub token, the staging callback's
# per-product Basic credentials, the WhatsApp gateway login and its pinned group. Mode 600.
deploy/stacks/*.pr-*
# The traffic store's password (D-107): prod.traffic-redis-auth, mode 600, 64 hex
# characters, generated by rebuild-restart.sh when absent.
deploy/stacks/*.traffic-*
!deploy/stacks/*.env.example

# Detached worktrees created by `rebuild-restart.sh --tag`. Each is a checkout
# of a ref this repository already contains, plus symlinks to the host-side env
# files above -- nothing here is a source of truth, and `git worktree remove`
# takes any of them back.
/.worktrees/

# One operator's instance material (D-085): private seeds, a second instance's
# edge blocks and redeploy overrides, the forbidden-strings list. Never
# committed; the README beside it is the one tracked file and says what goes
# where.
/deploy/local/*
!/deploy/local/README.md

# Built binaries
/dashboard/dashboard
/pustaka/pustaka
/pustaka/halaman
coverage.out

# Editor / OS noise
.DS_Store
*.swp
