# Secrets. Every deployed tier reads its credentials from a host-side file that
# is created by hand, chmod 600, and never committed. The *.example files next
# to them document the names.
deploy/stacks/*.env
deploy/stacks/*.aim-*
# The machine API's bearer tokens (D-072): prod.api-admin, prod.api-qa and
# prod.api-qa-out, gaos_<hex>, mode 600. The outbound one stays empty until the
# QA tools implement their side.
deploy/stacks/*.api-*
# The back office's accounts file and session key (D-079): prod.bo-users and
# prod.bo-session-key, mode 600. A hash file plus the key forges any session.
deploy/stacks/*.bo-*
!deploy/stacks/*.env.example

# Detached worktrees created by `rebuild-restart.sh --tag`. Each is a checkout
# of a ref this repository already contains, plus symlinks to the host-side env
# files above -- nothing here is a source of truth, and `git worktree remove`
# takes any of them back.
/.worktrees/

# Built binaries
/dashboard/dashboard
/pustaka/pustaka
/pustaka/halaman
coverage.out

# Editor / OS noise
.DS_Store
*.swp
